# 이 파일은 틀(템플릿)입니다. 실제 값을 채운 뒤 파일명을 .env로 바꿔서 사용하세요.
#   PowerShell: Copy-Item .env.example .env
# .env는 .gitignore에 의해 항상 무시되므로, 값 채운 뒤 git에는 절대 올라가지 않습니다.

# ===== 카카오맵 API 키 =====
# 각자 카카오 디벨로퍼스(developers.kakao.com)에서 본인 명의로 앱을 등록하고 발급받은 키를 넣으세요.
# JavaScript 키 (프론트엔드 - 지도 렌더링용)
# 주의: Vite가 이 값을 브라우저에 노출하려면 REACT_APP_ 접두사가 반드시 필요함 (기획 문서 관례)
REACT_APP_KAKAO_JS_KEY=

# REST API 키 (백엔드 - 주소 검색/좌표 변환용, 서버 전용, 프론트에 노출 금지)
KAKAO_REST_API_KEY=

# ===== 프론트엔드(front) =====
# 백엔드 API 주소. dev 서버는 vite.config.js의 proxy로 /api, /ws-stomp를 8080에 전달하므로 기본값 그대로 사용
REACT_APP_API_BASE_URL=/api

# ===== 백엔드(back) =====
# MySQL 접속 정보 (본인 로컬 환경에 맞게 수정)
MYSQL_DATABASE=help_map
MYSQL_USERNAME=
MYSQL_PASSWORD=

# React 개발 서버 주소 (CORS 허용용, 기본값 그대로 사용하면 생략 가능). 여러 개면 쉼표로 구분 (휴대폰 확인용 ngrok 주소 등)
FRONTEND_ORIGIN=http://localhost:5173

# 횡단보도 좌표 찍기 모드 (npm run dev에서만 동작). true면 지도에 crosswalks-surveyed.csv 줄 번호 마커를 띄우고,
# 지도를 누르면 그 자리의 CSV 한 줄을 복사한다. 시연 때는 넣지 않는다
# REACT_APP_CROSSWALK_SURVEY=true
