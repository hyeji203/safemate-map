# 환경변수 (API 키 등 민감정보) - back/.env, front/.env 둘 다 여기서 커버됨
.env
.env.local
.env.*.local
*.env
# 템플릿은 커밋 대상 (값이 비어 있는 틀)
!.env.example

# 로컬 전용 스프링 설정 (비밀번호 등을 직접 적어 쓰는 경우 대비)
application-local.yml
application-local.yaml
application-local.properties

